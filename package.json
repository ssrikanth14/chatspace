{
  "name": "chatspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:validate": "npm run db:validate --workspace=@chatspace/db",
    "db:generate": "npm run db:generate --workspace=@chatspace/db",
    "db:migrate": "npm run db:migrate --workspace=@chatspace/db",
    "db:push": "npm run db:push --workspace=@chatspace/db",
    "db:studio": "npm run db:studio --workspace=@chatspace/db"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
